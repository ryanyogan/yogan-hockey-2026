{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // TanStack Start's own advice: with it on, a server-only import can be kept in the browser's bundle.
    "verbatimModuleSyntax": false,
    "types": ["vite/client", "node", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".cloudflare/types"],
  "exclude": ["node_modules", "dist"]
}
